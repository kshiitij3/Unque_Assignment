@'
# Dependencies
**/node_modules/

# Expo generated files
**/.expo/
**/dist/
**/web-build/

# Environment secrets
**/.env
**/.env.*
!**/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db

# Test output
coverage/
'@ | Set-Content -Encoding utf8 .\.gitignore
